# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- IA ---
# OpenAI cubre agente + Whisper (voz).
OPENAI_API_KEY=

# --- Ruteo OpenAI ---
OPENAI_MODEL_FAST=gpt-5-mini
OPENAI_MODEL_HEAVY=gpt-5
OPENAI_MAX_TOOL_ITERATIONS=6
# Solo aplica a modelos "reasoning" (gpt-5*, o1*, o3*, o4*): minimal/low/medium/high
OPENAI_REASONING_EFFORT=high
# Solo aplica a modelos NO-reasoning (gpt-4o, gpt-4.1, etc). Ignorado en gpt-5.
OPENAI_TEMPERATURE=0.1

# --- RAG backend ---
# qdrant (VPS produccion) o sqlite (dev local con index.db)
RAG_BACKEND=qdrant

# --- Qdrant (produccion en VPS) ---
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=mg_docs
QDRANT_SEARCH_LIMIT=20

# --- RAG / SQLite legacy (solo si RAG_BACKEND=sqlite) ---
NAS_ROOT=/data/nas_mirror
INDEX_DB_PATH=/data/index.db
REINDEX_WORKERS=2
REINDEX_LOG=/data/logs/reindex.log

# --- Re-ranker semantico ---
# USE_RERANKER=1 activa el pipeline hibrido (retrieval + rerank). 0 = solo retrieval.
USE_RERANKER=1
# Modelo multilingual. Se baja automaticamente la primera vez (~470MB, cacheado).
RERANKER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Cuantos candidatos saca el retrieval antes de que el reranker los reordene.
RERANK_POOL=20

# --- Memoria por chat ---
MEMORY_DB_PATH=/data/memory.db

# --- Salida de escritos generados ---
DOCS_OUT_DIR=/data/escritos_generados

# --- Adjuntos por Telegram ---
DOC_MAX_SIZE_BYTES=20971520
DOC_MAX_CHARS=100000
IMG_MAX_SIZE_BYTES=10485760

# --- Google Docs (redaccion de escritos) ---
GOOGLE_SA_JSON=/data/service_account.json
GDOCS_TEMPLATE_ID=

# --- SAIJ / Poder Judicial Mendoza ---
SAIJ_SEARCH_URL=https://www.saij.gob.ar/busqueda

# --- RAG Gateway (OpenAI) para Open WebUI ---
# OPENAI_API_KEY ya definida arriba (linea 6), se reusa.
# gpt-4o para respuestas legales (precision). gpt-4o-mini para tareas auxiliares (query rewriting, summarize).
OPENAI_MODEL=gpt-4o
OPENAI_SUMMARIZE_MODEL=gpt-4o-mini
OPENAI_QUERY_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
# Retrieval
QDRANT_TOP_K=10             # cantidad final de hits al LLM
QDRANT_POOL=60              # candidatos pre-dedupe
SNIPPET_CHARS=1800          # tamaño max snippet por chunk
CONTEXT_RADIUS=1            # trae pag +/- N alrededor de cada hit (0 = solo la pag)
# Auto-compactacion (chars/4 ~= tokens)
COMPACT_THRESHOLD_TOKENS=12000
# Query expansion (LLM genera 3 variantes semanticas para ampliar retrieval)
ENABLE_QUERY_EXPANSION=1
# Nombre que ve Open WebUI en el selector de modelo
MODEL_NAME_EXPOSED=mg-bot

# --- API viejo (frontend estatico, ya no en uso con Open WebUI) ---
API_PORT=8000
API_CORS_ORIGINS=https://tu-dominio.com,http://localhost:3000

# --- Sync NAS -> VPS ---
# rclone remote config. Se genera con: rclone config
RCLONE_REMOTE=nas
RCLONE_SOURCE_PATH=/volume1/Publico/Estudio
RCLONE_LOCAL_MIRROR=/data/nas_mirror
