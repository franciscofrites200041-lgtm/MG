# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- IA ---
# OpenAI cubre agente + Whisper (voz).
OPENAI_API_KEY=

# --- Ruteo OpenAI ---
OPENAI_MODEL_FAST=gpt-5-mini
OPENAI_MODEL_HEAVY=gpt-5
OPENAI_MAX_TOOL_ITERATIONS=6

# --- RAG / NAS ---
NAS_ROOT=/mnt/nas/estudio
INDEX_DB_PATH=/data/index.db
REINDEX_WORKERS=2
REINDEX_LOG=/data/logs/reindex.log

# --- Re-ranker semantico ---
# USE_RERANKER=1 activa el pipeline hibrido (FTS5 + embeddings). 0 = solo FTS5.
USE_RERANKER=1
# Modelo multilingual. Se baja automaticamente la primera vez (~470MB, cacheado).
RERANKER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Cuantos candidatos saca FTS5 antes de que el reranker los reordene.
RERANK_POOL=20

# --- Memoria por chat ---
MEMORY_DB_PATH=/data/memory.db

# --- Salida de escritos generados ---
DOCS_OUT_DIR=/data/escritos_generados

# --- Google Docs (redaccion de escritos) ---
GOOGLE_SA_JSON=/data/service_account.json
GDOCS_TEMPLATE_ID=

# --- SAIJ / Poder Judicial Mendoza ---
SAIJ_SEARCH_URL=https://www.saij.gob.ar/busqueda
