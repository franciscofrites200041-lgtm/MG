# ==============================================================
# .env del stack MG Bot (VPS produccion)
# ==============================================================
# Copiar a .env y editar. Ninguno de estos valores tiene default
# seguro en el codigo, hay que ponerlos aca.

# --- OpenAI (unico proveedor de LLM) ---
OPENAI_API_KEY=sk-...
# Modelo principal para respuestas legales (calidad, sin mini)
OPENAI_MODEL=gpt-4o
# Modelos auxiliares (mas baratos): resumen de historial y expansion de query
OPENAI_SUMMARIZE_MODEL=gpt-4o-mini
OPENAI_QUERY_MODEL=gpt-4o-mini
# Base URL alternativa (dejar vacio para OpenAI oficial)
OPENAI_BASE_URL=

# Temperature para modelos NO-reasoning (gpt-4o, gpt-4.1, etc). Ignorado en gpt-5/o1/o3/o4.
OPENAI_TEMPERATURE=0.1

# Reasoning effort SOLO para modelos de razonamiento (gpt-5*, o1*, o3*, o4*).
# Valores validos: minimal | low | medium | high. Vacio = no se manda el param.
# Cambia solo esto si migras OPENAI_MODEL a un modelo reasoning.
OPENAI_REASONING_EFFORT=

# --- Qdrant (vector DB, unica fuente de verdad del RAG) ---
RAG_BACKEND=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=mg_docs

# --- Retrieval tuning ---
QDRANT_TOP_K=10            # hits finales pasados al LLM
QDRANT_POOL=60             # candidatos pre-dedupe
RERANK_TOP_N=30            # top-N que pasan por cross-encoder
SNIPPET_CHARS=1800         # tamaño max por snippet
CONTEXT_RADIUS=1           # pag +/- N alrededor de cada hit (0 = solo la pag)

# --- Cross-encoder rerank (opcional, sube precision) ---
ENABLE_CROSS_ENCODER=1
CROSS_ENCODER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# --- Query expansion (LLM genera 3 variantes semanticas) ---
ENABLE_QUERY_EXPANSION=1

# --- Compactacion de historial ---
# Cuando el chat supera este umbral (chars/4 ~= tokens), gpt-4o-mini
# resume los mensajes viejos y deja los ultimos 4 intactos.
COMPACT_THRESHOLD_TOKENS=12000

# --- Embedding model (mismo que se usa en indexacion) ---
USE_RERANKER=1
RERANKER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Branding ---
MODEL_NAME_EXPOSED=mg-bot
PUBLIC_BASE_URL=https://bot-estudio.montoya-gherzi.com.ar

# --- Web search de Open WebUI ---
# Engine: duckduckgo (default, sin key), google_pse, tavily, brave, serper,
# serply, jina, searxng, mojeek, bing, exa. Los que no son duckduckgo requieren
# key adicional (ver docs Open WebUI).
WEB_SEARCH_ENGINE=duckduckgo
WEB_SEARCH_RESULT_COUNT=5
WEB_SEARCH_CONCURRENT_REQUESTS=10

# --- Ingesta NAS via rclone (cron process_nas_ondemand.py) ---
RCLONE_REMOTE=nas
NAS_SHARE_PATH=Publico
VIRTUAL_ROOT=/volume1/Publico/Estudio
TMP_DIR=/tmp/nas_ondemand
RCLONE_CHUNK_TIMEOUT=1800
